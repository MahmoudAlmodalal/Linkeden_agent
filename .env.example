# ==========================================
# n8n & Server Configuration
# ==========================================
N8N_PORT=5678
GENERIC_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=

# ==========================================
# Ngrok Ingress Configuration
# ==========================================
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_reserved_domain.ngrok-free.app

# ==========================================
# Google Gemini API (Primary Engine)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Cloudflare Workers AI (Fallback Engine)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-70b-instruct
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_numeric_user_id_here

# ==========================================
# LinkedIn API & Profile Credentials
# ==========================================
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here
